SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Google Calendar integration (optional) ---
# Leave GOOGLE_CLIENT_ID blank to disable the integration entirely; the
# endpoints then return 503 and sync_user is a no-op.
#
# In the Google Cloud console:
#   - Scope: https://www.googleapis.com/auth/calendar.app.created
#     (secondary calendars only — it cannot touch your primary calendar)
#   - Publishing status MUST be "In production". Left on "Testing", Google
#     revokes refresh tokens after 7 days and the integration dies weekly.
#   - Register a redirect URI per environment; both may live on one client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# Where the OAuth callback redirects the browser back to.
FRONTEND_URL=http://localhost:5173

# Fernet key encrypting OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# STORE THIS SOMEWHERE DURABLE. Rotating or losing it silently invalidates
# every stored refresh token and forces every user to reconnect.
TOKEN_ENCRYPTION_KEY=

# Shared secret for POST /api/integrations/google/sync/reconcile, called by
# the nightly GitHub Actions cron. Any long random string.
CRON_SECRET=
